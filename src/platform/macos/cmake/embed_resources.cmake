# Generates a C++ table of the RCDATA entries in src/platform/resource.rc so the
# macOS build serves FindResourceW/LoadResource from the same files the Windows
# resource compiler embeds.
#
# Inputs: RC_FILE, HEADER_FILE, OUTPUT_FILE

file(READ "${HEADER_FILE}" header_text)
file(STRINGS "${RC_FILE}" rc_lines)
get_filename_component(rc_dir "${RC_FILE}" DIRECTORY)

set(entries "")
set(table "")
set(index 0)

foreach(line IN LISTS rc_lines)
    if(NOT line MATCHES "^[ \t]*(IDR_[A-Za-z0-9_]+)[ \t]+RCDATA[ \t]+\"([^\"]+)\"")
        continue()
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(rel_path "${CMAKE_MATCH_2}")

    if(NOT header_text MATCHES "#define[ \t]+${name}[ \t]+([0-9]+)")
        message(FATAL_ERROR "embed_resources: ${name} is not defined in ${HEADER_FILE}")
    endif()
    set(id "${CMAKE_MATCH_1}")

    get_filename_component(abs_path "${rc_dir}/${rel_path}" ABSOLUTE)
    if(NOT EXISTS "${abs_path}")
        message(FATAL_ERROR "embed_resources: ${abs_path} (${name}) does not exist")
    endif()

    file(READ "${abs_path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR byte_count "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")

    string(APPEND entries "alignas(16) static const unsigned char k_res_${index}[] = {\n${bytes}0x00};\n")
    string(APPEND table "    {${id}, k_res_${index}, ${byte_count}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by embed_resources.cmake from src/platform/resource.rc. Do not edit.\n")
string(APPEND content "#include \"platform/macos/win32/resources.h\"\n\n")
string(APPEND content "namespace {\n${entries}}\n\n")
string(APPEND content "const MacEmbeddedResource g_macEmbeddedResources[] = {\n${table}};\n")
string(APPEND content "const unsigned g_macEmbeddedResourceCount = ${index};\n")

if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" existing)
    if(existing STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT_FILE}" "${content}")
